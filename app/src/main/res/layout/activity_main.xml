<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/idcontent"
        android:layout_width="409dp"
        android:layout_height="729dp"
        android:orientation="vertical"
        android:padding="25dp"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_editor_absoluteX="1dp">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="119dp"
            app:srcCompat="@drawable/newclient" />

        <TextView
            android:id="@+id/label_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/name"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editText_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            android:inputType="text" />

        <TextView
            android:id="@+id/label_age"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/age"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editText_age"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            android:inputType="number" />

        <TextView
            android:id="@+id/label_rg_generos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/genero"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rg_generos"
            android:layout_width="match_parent"
            android:layout_height="96dp">

            <RadioButton
                android:id="@+id/rd_femenino"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/femenino" />

            <RadioButton
                android:id="@+id/rd_masculino"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/masculino" />
        </RadioGroup>

        <TextView
            android:id="@+id/spRol_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/rol"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spRol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/roles_array"
            android:spinnerMode="dropdown" />

        <CheckBox
            android:id="@+id/chk_terminos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/terminosAcepta" />

        <CheckBox
            android:id="@+id/chkinformacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/prom" />

        <Button
            android:id="@+id/btnCrear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="crearCliente"
            android:text="@string/crear" />

        <Button
            android:id="@+id/btnBorrar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="borrar"
            android:text="@string/borrar" />

        <Button
            android:id="@+id/btnMostrar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="mostrarClientes"
            android:text="@string/mostrar" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>